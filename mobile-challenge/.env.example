# Copy to .env and adjust. EXPO_PUBLIC_ variables are embedded in the bundle: never put secrets here.

# Repository implementation: local (default) | api
EXPO_PUBLIC_DATA_SOURCE=local

# Only used in api mode. On a physical device, use the computer's LAN IP (not localhost or 10.0.2.2).
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api/v1

# Optional, development only: lifetime in seconds of the tokens issued in local mode (default 10800 = 3 h).
# Set a short value (e.g. 60) to test session expiration; restart Metro after changing it.
# EXPO_PUBLIC_LOCAL_TOKEN_TTL_SECONDS=60
